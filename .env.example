# Copy to .env for local runs, or set these as environment variables on Render.
# All are optional; sensible defaults are baked into server.js.

# Port the server listens on. Render sets this automatically - leave unset there.
PORT=3000

# Host to bind to. Leave unset unless you have a specific reason to restrict it.
# HOST=0.0.0.0

# Where uploads/outputs are written on local disk. Defaults to ./tmp.
# DATA_DIR=/app/tmp

# Max accepted upload size, in megabytes.
MAX_UPLOAD_MB=750

# How long (ms) an uploaded file and its outputs stay on disk before
# automatic cleanup. Default is 4 hours.
FILE_TTL_MS=14400000

# Minimum ffmpeg scene-change score (0-1) to count as a candidate cut.
# This is the preferred threshold; detection can fall back to the lower
# threshold below when not enough cuts are found.
SCENE_MIN_SCORE=0.28

# Lower confidence floor for subtle hard cuts, such as LED-screen footage or
# compressed edits. Lower = more sensitive (more candidates, more false positives).
SCENE_FALLBACK_MIN_SCORE=0.18

# Minimum seconds between two accepted cut points, so the same real cut
# isn't counted twice.
MIN_CUT_SPACING_SECONDS=1

# Optional basic auth. If either is unset, the app is open to anyone with
# the URL - set both before sharing outside a trusted network.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
